{
  "name": "tmua-tutor-app",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "ingest": "node scripts/ingest.mjs",
    "dev:web": "vite web",
    "build": "vite build web",
    "start": "node server/index.js",
    "test": "node --experimental-test-module-mocks --test --test-timeout=400000 \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\" \"tests/e2e/*.test.mjs\"",
    "test:py": "python3 -m pytest tts/tests/ -q",
    "dashboard": "node -e \"import('./server/dashboard.js').then(m=>console.log(JSON.stringify(m.buildDashboard())))\"",
    "voice:build": "node tts/build_linebank.mjs",
    "voice:test": "python3 tts/monday_tts.py --once \"Given \\$f(x)=\\\\frac{x^2-1}{x-2}\\$, find \\$f'(2)\\$.\" --mood focused",
    "voice:clean": "python3 tts/monday_tts.py --purge-cache",
    "tokens": "node scripts/build-tokens.mjs",
    "icons": "node scripts/make-icons.mjs",
    "prebuild": "node scripts/build-tokens.mjs",
    "publish": "node scripts/publish-dashboard.mjs",
    "voice:setup": "node tts/setup.mjs",
    "voice:doctor": "node tts/doctor.mjs",
    "pageindex": "node scripts/build-page-index.mjs",
    "classify:validate": "node scripts/validate-classification.mjs",
    "classify:merge": "node scripts/merge-mock-classification.mjs",
    "answers:official": "node scripts/extract-official-answers.mjs",
    "mutant": "node scripts/mutant-paper.mjs",
    "backlog:paper": "node scripts/backlog-paper.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.203",
    "@fontsource/open-sans": "^5.3.0",
    "@mathjax/mathjax-stix2-font": "^4.1.3",
    "chokidar": "^5.0.0",
    "mathjax": "^4.1.3",
    "node-ical": "^0.27.1",
    "spin.js": "^2.3.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "katex": "^0.17.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^8.1.3"
  }
}
